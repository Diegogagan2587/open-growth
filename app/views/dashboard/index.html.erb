<section class="space-y-7 p-4 sm:p-8">
  <header class="space-y-2">
    <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl"><%= t("dashboard.next_steps_title") %></h1>
    <p class="max-w-2xl text-sm text-muted-foreground sm:text-base"><%= t("dashboard.next_steps_description") %></p>
  </header>

  <% if @pending_tasks.any? %>
    <section class="space-y-2">
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <h2 class="text-base font-semibold text-foreground"><%= t("dashboard.tasks_to_do") %></h2>
          <span class="rounded-full bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground"><%= @pending_tasks.size %></span>
        </div>
        <%= link_to t("dashboard.view_all_tasks"), task_root_path, class: "shrink-0 text-sm font-medium text-accent hover:text-accent-dark hover:underline" %>
      </div>
      <ul class="divide-y divide-border border-y border-border text-sm">
        <% @pending_tasks.each do |task| %>
          <%= render Dashboard::PendingTaskRowComponent.new(task: task) %>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if Current.account %>
    <section class="min-w-0 space-y-3">
      <div class="flex min-w-0 flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
        <div class="min-w-0">
          <h2 class="text-lg font-semibold text-foreground">Money to follow up</h2>
          <p class="text-sm text-muted-foreground">Overdue and upcoming items due in the next 14 days.</p>
        </div>
        <%= link_to "All planned transactions", finance_planned_transactions_path, class: "self-start text-sm font-medium text-accent hover:underline sm:shrink-0 sm:self-auto" %>
      </div>

      <div class="grid min-w-0 gap-4 lg:grid-cols-2">
        <section class="min-w-0 rounded-xl border border-border bg-card p-4">
          <h3 class="mb-3 text-sm font-semibold text-foreground">Planned transactions</h3>
          <% if @pending_planned_transactions.any? %>
            <ul class="space-y-2">
              <% @pending_planned_transactions.each do |transaction| %>
                <% due_date = transaction.due_date || transaction.planned_for %>
                <li class="flex min-w-0 flex-col gap-1 border-b border-border pb-2 last:border-0 last:pb-0 sm:flex-row sm:items-start sm:justify-between sm:gap-3">
                  <div class="min-w-0">
                    <div class="break-words text-sm font-medium text-foreground"><%= transaction.description %></div>
                    <div class="text-xs text-muted-foreground"><%= due_date < Date.current ? "Overdue" : "Due" %> <%= l(due_date, format: :short) %></div>
                  </div>
                  <div class="flex min-w-0 items-center justify-between gap-3 sm:shrink-0 sm:flex-col sm:items-end sm:gap-0">
                    <div class="text-sm font-semibold text-foreground"><%= number_to_currency(transaction.amount) %></div>
                    <%= link_to "Review", transaction.plan ? finance_plan_path(transaction.plan) : finance_planned_transactions_path, class: "text-xs text-accent hover:underline" %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-muted-foreground">No planned transactions due soon.</p>
          <% end %>
        </section>

        <section class="min-w-0 rounded-xl border border-border bg-card p-4">
          <h3 class="mb-3 text-sm font-semibold text-foreground">Expected money</h3>
          <% if @expected_funding.any? %>
            <ul class="space-y-2">
              <% @expected_funding.each do |source| %>
                <li class="flex min-w-0 flex-col gap-1 border-b border-border pb-2 last:border-0 last:pb-0 sm:flex-row sm:items-start sm:justify-between sm:gap-3">
                  <div class="min-w-0">
                    <div class="break-words text-sm font-medium text-foreground"><%= source.description %></div>
                    <div class="text-xs text-muted-foreground"><%= source.expected_date < Date.current ? "Overdue" : "Expected" %> <%= l(source.expected_date, format: :short) %></div>
                  </div>
                  <div class="flex min-w-0 items-center justify-between gap-3 sm:shrink-0 sm:flex-col sm:items-end sm:gap-0">
                    <div class="text-sm font-semibold text-foreground"><%= number_to_currency(source.expected_amount) %></div>
                    <%= link_to "Review", finance_plan_path(source.financial_plan), class: "text-xs text-accent hover:underline" %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-muted-foreground">No expected income due soon.</p>
          <% end %>
        </section>
      </div>
    </section>
  <% end %>

  <section class="space-y-3">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Core Workspace</h2>
    <nav class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
      <%= link_to finance_entries_path(entry_type: "expenses"), class: "group rounded-xl border border-border bg-card p-5 shadow-sm transition-colors hover:bg-muted/35" do %>
        <h3 class="text-base font-semibold text-foreground">Expenses</h3>
        <p class="mt-1 text-sm text-muted-foreground"><%= t("dashboard.expenses_description") %></p>
      <% end %>

      <%= link_to finance_plans_path, class: "group rounded-xl border border-border bg-card p-5 shadow-sm transition-colors hover:bg-muted/35" do %>
        <h3 class="text-base font-semibold text-foreground">Financial plans</h3>
        <p class="mt-1 text-sm text-muted-foreground"><%= t("dashboard.income_events_description") %></p>
      <% end %>

      <%= link_to budget_periods_path, class: "group rounded-xl border border-border bg-card p-5 shadow-sm transition-colors hover:bg-muted/35" do %>
        <h3 class="text-base font-semibold text-foreground">Budget Periods</h3>
        <p class="mt-1 text-sm text-muted-foreground"><%= t("dashboard.budget_periods_description") %></p>
      <% end %>

      <%= link_to finance_path, class: "group rounded-xl border border-border bg-card p-5 shadow-sm transition-colors hover:bg-muted/35" do %>
        <h3 class="text-base font-semibold text-foreground">Finance</h3>
        <p class="mt-1 text-sm text-muted-foreground">Accounts, liabilities, entries, and repayment flow.</p>
      <% end %>

      <%= link_to task_root_path, class: "group rounded-xl border border-border bg-card p-5 shadow-sm transition-colors hover:bg-muted/35" do %>
        <h3 class="text-base font-semibold text-foreground"><%= t("nav.tasks") %></h3>
        <p class="mt-1 text-sm text-muted-foreground"><%= t("task.recurring_tasks.index.title") %></p>
      <% end %>

      <%= link_to reports_path, class: "group rounded-xl border border-border bg-card p-5 shadow-sm transition-colors hover:bg-muted/35" do %>
        <h3 class="text-base font-semibold text-foreground">Reports</h3>
        <p class="mt-1 text-sm text-muted-foreground"><%= t("dashboard.reports_description") %></p>
      <% end %>
    </nav>
  </section>

  <section class="space-y-3">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Supporting Modules</h2>
    <nav class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
      <%= link_to expense_templates_path, class: "rounded-xl border border-border bg-card p-4 text-sm font-medium text-foreground hover:bg-muted/35" do %>
        <%= t("dashboard.expense_templates_title") %>
      <% end %>
      <%= link_to finance_categories_path, class: "rounded-xl border border-border bg-card p-4 text-sm font-medium text-foreground hover:bg-muted/35" do %>
        <%= t("dashboard.categories_title") %>
      <% end %>
      <%= link_to shopping_items_path, class: "rounded-xl border border-border bg-card p-4 text-sm font-medium text-foreground hover:bg-muted/35" do %>
        <%= t("dashboard.shopping_list_title") %>
      <% end %>
      <%= link_to inventory_items_path, class: "rounded-xl border border-border bg-card p-4 text-sm font-medium text-foreground hover:bg-muted/35" do %>
        <%= t("dashboard.home_inventory_title") %>
      <% end %>
    </nav>
  </section>
</section>
