<div class="fixed inset-0 z-50 flex items-end justify-center md:items-center md:p-4" data-controller="quick-add-menu">
  <div class="fixed inset-0 bg-black/50 backdrop-blur-[1px]" data-action="click->quick-add-menu#closeModal"></div>

  <section data-quick-add-task-panel class="relative max-h-[92dvh] w-full overflow-y-auto rounded-t-3xl border border-border bg-card pb-[env(safe-area-inset-bottom)] shadow-2xl md:max-w-xl md:rounded-2xl md:pb-0">
    <div class="px-4 pt-3 md:px-6 md:pt-6">
      <div class="mx-auto mb-3 h-1 w-10 rounded-full bg-muted-foreground/30 md:hidden"></div>
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-foreground"><%= t("quick_add.task_form.title") %></h2>
          <p class="mt-1 hidden text-sm text-muted-foreground md:block"><%= t("quick_add.task_form.subtitle") %></p>
        </div>
        <button type="button" data-action="click->quick-add-menu#closeModal" aria-label="<%= t('quick_add.task_form.close') %>" class="rounded-md p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
          <svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <div class="p-4 md:p-6">
      <%= form_with model: @task, url: quick_add_create_task_path, local: false, scope: :task, data: { turbo: true } do |form| %>
        <% if @task.errors.any? %>
          <div class="mb-4 rounded border border-danger-soft bg-danger-soft p-4">
            <h3 class="mb-2 text-sm font-semibold text-danger"><%= t("quick_add.task_form.errors", count: @task.errors.count) %></h3>
            <ul class="list-inside list-disc text-sm text-danger">
              <% @task.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :title, t("quick_add.task_form.title_label"), class: "sr-only" %>
          <%= form.text_field :title, autofocus: true, data: { quick_add_menu_target: "taskTitle" }, class: "w-full border-0 bg-transparent px-0 py-3 text-xl font-medium text-foreground outline-none placeholder:text-muted-foreground/70 focus:ring-0 md:text-2xl", placeholder: t("quick_add.task_form.title_placeholder") %>
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-2">
          <label class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-3 text-sm text-foreground">
            <svg aria-hidden="true" class="size-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="m12 3 1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2L12 3Z" />
            </svg>
            <span class="sr-only"><%= t("quick_add.task_form.priority_label") %></span>
            <%= form.select :priority, Projects::Task::PRIORITIES.map { |priority| [t("tasks.priority.#{priority}"), priority] }, {}, class: "max-w-28 border-0 bg-transparent p-0 pr-5 text-sm text-foreground focus:ring-0" %>
          </label>

          <label class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-3 text-sm text-muted-foreground">
            <svg aria-hidden="true" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="5" width="18" height="16" rx="2" />
              <path stroke-linecap="round" d="M16 3v4M8 3v4M3 10h18" />
            </svg>
            <span class="sr-only"><%= t("quick_add.task_form.due_date_label") %></span>
            <%= form.date_field :due_date, class: "w-32 border-0 bg-transparent p-0 text-sm text-foreground focus:ring-0" %>
          </label>

          <button type="button" data-action="quick-add-menu#toggleDetails" aria-expanded="false" aria-controls="quick-add-task-details" class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-3 text-sm font-medium text-foreground hover:bg-muted md:hidden">
            <svg aria-hidden="true" class="size-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
            </svg>
            <%= t("quick_add.task_form.details") %>
          </button>
        </div>

        <div id="quick-add-task-details" data-quick-add-menu-target="details" class="mt-4 hidden md:block">
          <%= form.label :description, t("quick_add.task_form.description_label"), class: "sr-only" %>
          <%= form.text_area :description, class: "min-h-28 w-full resize-y rounded-lg border border-input bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary", rows: 4, placeholder: t("quick_add.task_form.description_placeholder") %>
        </div>

        <div class="mt-5 flex flex-col-reverse gap-2 border-t border-border pt-4 md:flex-row md:justify-end">
          <button type="button" data-action="click->quick-add-menu#closeModal" class="rounded-lg border border-input px-4 py-3 font-medium text-foreground hover:bg-accent md:py-2"><%= t("quick_add.task_form.cancel") %></button>
          <%= form.submit t("quick_add.task_form.submit"), class: "rounded-lg bg-primary px-4 py-3 font-semibold text-primary-foreground hover:bg-primary/90 md:py-2" %>
        </div>
      <% end %>
    </div>
  </section>
</div>
