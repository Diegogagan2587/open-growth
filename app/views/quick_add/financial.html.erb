<div class="fixed inset-0 z-50 flex items-end justify-center md:items-center md:p-4" data-controller="quick-add-menu">
  <div class="fixed inset-0 bg-black/50 backdrop-blur-[1px]" data-action="click->quick-add-menu#closeModal"></div>

  <section data-quick-add-financial-panel class="relative max-h-[92dvh] w-full overflow-y-auto rounded-t-3xl border border-border bg-card pb-[env(safe-area-inset-bottom)] shadow-2xl md:max-w-xl md:rounded-2xl md:pb-0">
    <div class="px-4 pt-3 md:px-6 md:pt-6">
      <div class="mx-auto mb-3 h-1 w-10 rounded-full bg-muted-foreground/30 md:hidden"></div>
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-foreground"><%= t("quick_add.money_form.title") %></h2>
          <p class="mt-1 hidden text-sm text-muted-foreground md:block"><%= t("quick_add.money_form.subtitle") %></p>
        </div>
        <button type="button" data-action="click->quick-add-menu#closeModal" aria-label="<%= t('quick_add.money_form.close') %>" class="rounded-md p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
          <svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <div class="p-4 md:p-6">
      <div data-controller="quick-add-tabs" class="space-y-4">
        <div role="tablist" aria-label="<%= t('quick_add.money_form.tabs_label') %>" class="grid grid-cols-3 border-b border-border">
          <button type="button" role="tab" aria-selected="true" data-quick-add-tabs-target="tab" data-panel="expense-panel" data-action="click->quick-add-tabs#selectTab" class="-mb-px inline-flex min-h-12 flex-col items-center justify-center gap-1 border-b-2 border-transparent px-2 py-2 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground aria-selected:border-primary aria-selected:font-semibold aria-selected:text-primary focus-visible:underline focus-visible:underline-offset-4 sm:flex-row sm:gap-2 sm:px-3 sm:text-sm">
            <svg aria-hidden="true" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5zM8 8h8m-8 4h8m-8 4h4" /></svg>
            <%= t("quick_add.money_form.expense") %>
          </button>
          <button type="button" role="tab" aria-selected="false" data-quick-add-tabs-target="tab" data-panel="income-panel" data-action="click->quick-add-tabs#selectTab" class="-mb-px inline-flex min-h-12 flex-col items-center justify-center gap-1 border-b-2 border-transparent px-2 py-2 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground aria-selected:border-primary aria-selected:font-semibold aria-selected:text-primary focus-visible:underline focus-visible:underline-offset-4 sm:flex-row sm:gap-2 sm:px-3 sm:text-sm">
            <svg aria-hidden="true" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m0 0 6 6m-6-6-6 6" /></svg>
            <%= t("quick_add.money_form.income") %>
          </button>
          <button type="button" role="tab" aria-selected="false" data-quick-add-tabs-target="tab" data-panel="transfer-panel" data-action="click->quick-add-tabs#selectTab" class="-mb-px inline-flex min-h-12 flex-col items-center justify-center gap-1 border-b-2 border-transparent px-2 py-2 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground aria-selected:border-primary aria-selected:font-semibold aria-selected:text-primary focus-visible:underline focus-visible:underline-offset-4 sm:flex-row sm:gap-2 sm:px-3 sm:text-sm">
            <svg aria-hidden="true" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h13m0 0-4-4m4 4-4 4M17 17H4m0 0 4 4m-4-4 4-4" /></svg>
            <%= t("quick_add.money_form.transfer") %>
          </button>
        </div>

        <div id="expense-panel" role="tabpanel" data-quick-add-tabs-target="panel" class="space-y-4">
          <%= render "quick_add/expense_form" %>
        </div>

        <div id="income-panel" role="tabpanel" data-quick-add-tabs-target="panel" class="hidden space-y-4">
          <%= render "quick_add/income_form" %>
        </div>

        <div id="transfer-panel" role="tabpanel" data-quick-add-tabs-target="panel" class="hidden space-y-4">
          <%= render "quick_add/transfer_form" %>
        </div>
      </div>
    </div>
  </section>
</div>
