<%= form_with url: quick_add_create_expense_path, local: false, data: { turbo: true, quick_add_offline: true } do |f| %>
  <div class="space-y-3">
    <div>
      <label class="block text-sm font-medium text-foreground mb-1">Description</label>
      <%= render Ui::InputComponent.new(name: "expense[description]", placeholder: "Groceries", value: @expense&.description, required: true) %>
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-1">Amount</label>
      <%= render Ui::InputComponent.new(name: "expense[amount]", type: "number", placeholder: "0.00", step: "0.01", value: @expense&.amount, required: true) %>
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-1">From account</label>
      <%= render Ui::SelectComponent.new(
        name: "expense[origin]",
        options: (Current.account&.financial_accounts&.active || []).map { |account| ["#{account.account_group.humanize}: #{account.name}", account.id] },
        selected: nil,
        include_blank: "Select account",
        required: true,
        searchable: true
      ) %>
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-1">Category</label>
      <%= render Ui::SelectComponent.new(
        name: "expense[category_id]",
        options: Current.account&.categories&.pluck(:name, :id) || [],
        selected: @expense&.category_id,
        include_blank: "Select category",
        required: true,
        searchable: true
      ) %>
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-1">Plan (optional)</label>
      <%= render Ui::SelectComponent.new(
        name: "expense[income_event_id]",
        options: (Current.account&.financial_plans&.chronological || []).map { |plan| ["#{plan.name} (#{plan.planned_for.strftime('%Y-%m-%d')})", plan.id] },
        selected: @expense&.income_event_id,
        include_blank: "None",
        searchable: true
      ) %>
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-1">Date</label>
      <%= render Ui::InputComponent.new(name: "expense[date]", type: "date", value: @expense&.date || Date.today, required: true) %>
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-1">Time (optional)</label>
      <%= render Ui::InputComponent.new(name: "expense[time]", type: "time") %>
    </div>

    <div class="flex justify-end gap-2 pt-2">
      <%= render Ui::ButtonComponent.new(label: "Create Expense", variant: :default, type: "submit") %>
    </div>
  </div>
<% end %>
