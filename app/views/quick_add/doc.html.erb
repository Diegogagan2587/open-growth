<div class="fixed inset-0 z-50 flex items-end justify-center md:items-center md:p-4" data-controller="quick-add-menu">
  <div class="fixed inset-0 bg-black/50 backdrop-blur-[1px]" data-action="click->quick-add-menu#closeModal"></div>

  <section class="relative max-h-[92dvh] w-full overflow-y-auto rounded-t-3xl border border-border bg-card pb-[env(safe-area-inset-bottom)] shadow-2xl md:max-w-xl md:rounded-2xl md:pb-0">
    <div class="px-4 pt-3 md:px-6 md:pt-6">
      <div class="mx-auto mb-3 h-1 w-10 rounded-full bg-muted-foreground/30 md:hidden"></div>
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-foreground"><%= t("quick_add.doc_form.title") %></h2>
          <p class="mt-1 hidden text-sm text-muted-foreground md:block"><%= t("quick_add.doc_form.subtitle") %></p>
        </div>
        <button type="button" data-action="click->quick-add-menu#closeModal" aria-label="<%= t('quick_add.doc_form.close') %>" class="rounded-md p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
          <svg aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <div class="p-4 md:p-6">
      <%= form_with model: @doc, url: docs_path, method: :post, local: false, scope: :doc, data: { turbo: true } do |form| %>
        <% if @doc.errors.any? %>
          <div class="mb-4 rounded-lg border border-danger-soft bg-danger-soft p-4" role="alert">
            <h3 class="mb-2 text-sm font-semibold text-danger"><%= t("quick_add.doc_form.errors", count: @doc.errors.count) %></h3>
            <ul class="list-inside list-disc text-sm text-danger">
              <% @doc.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :title, t("quick_add.doc_form.title_label"), class: "sr-only" %>
          <%= form.text_field :title, autofocus: true, required: true, autocomplete: "off", data: { quick_add_autofocus: true }, class: "w-full border-0 bg-transparent px-0 py-3 text-xl font-medium text-foreground outline-none placeholder:text-muted-foreground/70 focus:ring-0 md:text-2xl", placeholder: t("quick_add.doc_form.title_placeholder") %>
        </div>

        <div class="mt-2 flex flex-wrap items-center gap-2">
          <label class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-3 text-sm text-foreground">
            <svg aria-hidden="true" class="size-4 shrink-0 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 3.75h6.5L19 9.25v11A1.75 1.75 0 0 1 17.25 22h-10.5A1.75 1.75 0 0 1 5 20.25V5.5a1.75 1.75 0 0 1 2-1.75ZM13 4v5h5m-10 5h8m-8 4h8" />
            </svg>
            <span class="sr-only"><%= t("quick_add.doc_form.type") %></span>
            <%= form.select :doc_type, Projects::Doc::DOC_TYPES.map { |type| [ t("quick_add.doc_form.types.#{type}"), type ] }, {}, aria: { label: t("quick_add.doc_form.type") }, class: "max-w-32 border-0 bg-transparent p-0 pr-5 text-sm text-foreground focus:ring-0" %>
          </label>
        </div>

        <div class="mt-4 border-t border-border/70 pt-2">
          <%= form.label :content, t("quick_add.doc_form.content"), class: "sr-only" %>
          <%= form.text_area :content, rows: 8, class: "min-h-48 w-full resize-y border-0 bg-transparent px-0 py-2 text-base leading-7 text-foreground outline-none placeholder:text-muted-foreground/70 focus:ring-0", placeholder: t("quick_add.doc_form.content_placeholder") %>
        </div>

        <div class="sticky bottom-0 -mx-4 mt-3 border-t border-border bg-card/95 px-4 pb-1 pt-3 backdrop-blur md:static md:mx-0 md:flex md:justify-end md:gap-2 md:bg-transparent md:p-0 md:pt-4">
          <button type="button" data-action="click->quick-add-menu#closeModal" class="hidden rounded-lg border border-input px-4 py-2 font-medium text-foreground hover:bg-muted md:inline-flex"><%= t("quick_add.doc_form.cancel") %></button>
          <%= form.submit t("quick_add.doc_form.submit"), class: "w-full rounded-lg bg-primary px-4 py-3 font-semibold text-primary-foreground transition-colors hover:bg-primary/90 md:w-auto md:py-2" %>
        </div>
      <% end %>
    </div>
  </section>
</div>
