<% url = @recurring_transaction.persisted? ? finance_recurring_transaction_path(@recurring_transaction) : finance_recurring_transactions_path %>
<%= form_with model: @recurring_transaction, scope: :financial_recurring_transaction, url: url, class: "grid gap-4 rounded-xl border border-border bg-card p-6 shadow-sm sm:grid-cols-2" do |form| %>
  <% if @recurring_transaction.errors.any? %>
    <p class="sm:col-span-2 text-sm text-destructive"><%= @recurring_transaction.errors.full_messages.to_sentence %></p>
  <% end %>

  <label class="space-y-1 text-sm">Name<%= render Ui::InputComponent.new(name: "financial_recurring_transaction[name]", value: @recurring_transaction.name, required: true) %></label>
  <label class="space-y-1 text-sm">Amount<%= render Ui::InputComponent.new(name: "financial_recurring_transaction[amount]", value: @recurring_transaction.amount, type: "number", min: 0.01, step: 0.01, required: true) %></label>
  <label class="space-y-1 text-sm">Frequency<%= render Ui::SelectComponent.new(name: "financial_recurring_transaction[frequency]", options: Financial::RecurringTransaction::FREQUENCIES.map { |frequency| [frequency.humanize, frequency] }, selected: @recurring_transaction.frequency, required: true) %></label>
  <label class="space-y-1 text-sm">Source account<%= render Ui::SelectComponent.new(name: "financial_recurring_transaction[source_account_id]", options: @financial_accounts.map { |account| ["#{account.account_group.humanize}: #{account.name}", account.id] }, selected: @recurring_transaction.source_account_id, include_blank: "Choose when planning") %></label>
  <label class="space-y-1 text-sm">Destination account<%= render Ui::SelectComponent.new(name: "financial_recurring_transaction[destination_account_id]", options: @financial_accounts.map { |account| ["#{account.account_group.humanize}: #{account.name}", account.id] }, selected: @recurring_transaction.destination_account_id, include_blank: "Not needed") %></label>
  <label class="space-y-1 text-sm">Category<%= render Ui::SelectComponent.new(name: "financial_recurring_transaction[category_id]", options: @categories.map { |category| [category.name, category.id] }, selected: @recurring_transaction.category_id, include_blank: "Not needed when budget neutral") %></label>
  <label class="space-y-1 text-sm">Importance<%= render Ui::SelectComponent.new(name: "financial_recurring_transaction[importance]", options: Financial::PlannedTransaction::IMPORTANCES.map { |importance| [importance.humanize, importance] }, selected: @recurring_transaction.importance, required: true) %></label>
  <label class="space-y-1 text-sm">Status<%= render Ui::SelectComponent.new(name: "financial_recurring_transaction[status]", options: Financial::RecurringTransaction::STATUSES.map { |status| [status.humanize, status] }, selected: @recurring_transaction.status, required: true) %></label>
  <label class="flex items-center gap-2 self-end rounded-md border border-border px-3 py-2 text-sm"><%= form.check_box :budget_consuming %><span>Consumes the Plan budget</span></label>
  <label class="space-y-1 text-sm sm:col-span-2">Description<%= render Ui::InputComponent.new(name: "financial_recurring_transaction[description]", value: @recurring_transaction.description) %></label>
  <label class="space-y-1 text-sm sm:col-span-2">Notes<%= form.text_area :notes, rows: 3, class: "w-full rounded-md border border-input bg-background px-3 py-2" %></label>
  <div class="flex gap-2 sm:col-span-2"><%= render Ui::ButtonComponent.new(label: @recurring_transaction.persisted? ? "Save recurring transaction" : "Create recurring transaction", type: "submit") %><%= render Ui::ButtonComponent.new(href: @recurring_transaction.persisted? ? finance_recurring_transaction_path(@recurring_transaction) : finance_recurring_transactions_path, label: "Cancel", variant: :outline) %></div>
<% end %>
