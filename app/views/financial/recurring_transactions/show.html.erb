<section class="container mx-auto space-y-6 px-4 py-6">
  <div><%= link_to "← Back to recurring transactions", finance_recurring_transactions_path, class: "text-sm text-primary hover:underline" %></div>
  <header class="flex flex-wrap items-start justify-between gap-4 rounded-xl border border-border bg-card p-5 shadow-sm">
    <div><div class="flex flex-wrap gap-2"><%= render Ui::BadgeComponent.new(label: @recurring_transaction.frequency.humanize, variant: :outline) %><%= render Ui::BadgeComponent.new(label: @recurring_transaction.status.humanize, variant: :outline) %></div><h1 class="mt-2 text-3xl font-bold"><%= @recurring_transaction.name %></h1><p class="mt-1 text-muted-foreground"><%= @recurring_transaction.routing_summary %></p></div>
    <div class="flex gap-2"><%= render Ui::ButtonComponent.new(href: edit_finance_recurring_transaction_path(@recurring_transaction), label: "Edit", variant: :outline) %><%= render Ui::ButtonComponent.new(href: finance_recurring_transaction_path(@recurring_transaction), label: @planned_transactions.any? ? "Archive" : "Delete", variant: :destructive, method: :delete, data: { turbo_confirm: "Stop using this recurring transaction? Existing occurrences will be preserved." }) %></div>
  </header>
  <dl class="grid gap-4 rounded-xl border border-border bg-card p-5 sm:grid-cols-2 lg:grid-cols-4"><div><dt class="text-sm text-muted-foreground">Amount</dt><dd class="font-semibold"><%= number_to_currency(@recurring_transaction.amount) %></dd></div><div><dt class="text-sm text-muted-foreground">Kind</dt><dd class="font-semibold"><%= @recurring_transaction.transaction_kind.humanize %></dd></div><div><dt class="text-sm text-muted-foreground">Plan treatment</dt><dd class="font-semibold"><%= @recurring_transaction.budget_consuming? ? "Consumes budget" : "Neutral" %></dd></div><div><dt class="text-sm text-muted-foreground">Category</dt><dd class="font-semibold"><%= @recurring_transaction.category&.name || "None" %></dd></div></dl>
  <section class="space-y-3"><h2 class="text-xl font-semibold">Planned occurrences</h2><% @planned_transactions.each do |transaction| %><article class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-border bg-card p-4"><div><p class="font-semibold"><%= transaction.description %></p><p class="text-sm text-muted-foreground"><%= transaction.plan&.name || "Unassigned" %> · <%= l(transaction.planned_execution_date) if transaction.planned_execution_date %></p></div><div class="flex items-center gap-2"><%= render Ui::BadgeComponent.new(label: transaction.execution_status.humanize, variant: :outline) %><strong><%= number_to_currency(transaction.planned_amount) %></strong></div></article><% end %><% if @planned_transactions.empty? %><p class="rounded-xl border border-dashed border-border p-5 text-muted-foreground">No planned occurrences yet. Pick this recurring transaction from an open Plan.</p><% end %></section>
</section>
