<section class="mx-auto max-w-5xl space-y-6 p-6 sm:p-8">
  <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold">Category budget</h1>
      <p class="mt-1 text-sm text-muted-foreground">Compare spending across all accounts with your category limits.</p>
    </div>
    <%= form_with url: finance_category_budgets_path, method: :get, class: "flex flex-wrap items-end gap-2" do %>
      <label class="text-sm">View period
        <%= select_tag :period, options_for_select([["This week", "week"], ["Two weeks", "two_weeks"], ["This month", "month"], ["Custom dates", "custom"]], @period), class: "mt-1 block rounded border-border bg-card" %>
      </label>
      <label class="text-sm">From <%= date_field_tag :start_date, @range_start, class: "mt-1 block rounded border-border bg-card" %></label>
      <label class="text-sm">To <%= date_field_tag :end_date, @range_end, class: "mt-1 block rounded border-border bg-card" %></label>
      <%= render Ui::ButtonComponent.new(label: "Show", type: :submit, variant: :outline) %>
    <% end %>
  </header>

  <p class="text-sm text-muted-foreground">Showing <%= l(@range_start) %> – <%= l(@range_end) %>. Budgets are adjusted to these dates.</p>

  <% if @rows.any? %>
    <div class="space-y-3">
      <% @rows.each do |row| %>
        <% budget = row.budget %>
        <% percent = row.allowance.zero? ? 0 : (row.spent / row.allowance * 100).round %>
        <% over = row.spent > row.allowance %>
        <article class="rounded-xl border border-border bg-card p-4 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="font-semibold"><%= link_to budget.category.name, finance_entries_path(category_id: budget.category_id, date_from: @range_start, date_to: @range_end), class: "hover:text-primary hover:underline" %></h2>
              <p class="text-sm text-muted-foreground"><%= number_to_currency(row.spent) %> of <%= number_to_currency(row.allowance) %> · <%= over ? "Over by #{number_to_currency(-row.remaining)}" : "#{number_to_currency(row.remaining)} left" %></p>
            </div>
            <span class="text-sm font-medium <%= over ? "text-danger" : "text-success" %>"><%= percent %>%</span>
          </div>
          <div class="mt-3 h-3 overflow-hidden rounded-full bg-muted" role="progressbar" aria-label="<%= budget.category.name %> budget used" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= [percent, 100].min %>">
            <div class="h-full rounded-full <%= over ? "bg-danger" : "bg-success" %>" style="width: <%= [percent, 100].min %>%"></div>
          </div>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-3">
            <span class="text-xs text-muted-foreground"><%= number_to_currency(budget.amount) %> / <%= budget.frequency == "custom" ? "#{budget.custom_days} days" : budget.frequency %></span>
            <%= form_with model: budget, url: finance_category_budget_path(budget), method: :patch, class: "flex flex-wrap items-end gap-2" do |form| %>
              <%= form.label :amount, "Limit", class: "text-xs" %><%= form.number_field :amount, step: "0.01", min: "0.01", class: "w-28 rounded border-border bg-card px-2 py-1 text-sm" %>
              <%= form.select :frequency, Financial::CategoryBudget::FREQUENCIES.map { |frequency| [frequency.humanize, frequency] }, {}, class: "rounded border-border bg-card px-2 py-1 text-sm" %>
              <%= form.number_field :custom_days, min: 1, placeholder: "Days", class: "w-20 rounded border-border bg-card px-2 py-1 text-sm" %>
              <%= form.date_field :starts_on, class: "rounded border-border bg-card px-2 py-1 text-sm" %>
              <%= form.submit "Save", class: "rounded bg-primary px-3 py-1 text-sm text-white" %>
              <%= link_to "Remove", finance_category_budget_path(budget), data: { turbo_method: :delete, turbo_confirm: "Remove this category budget?" }, class: "text-sm text-danger" %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-xl border border-dashed border-border p-6 text-muted-foreground">No category budgets yet. Add one below to start tracking spending.</p>
  <% end %>

  <% if @categories.any? %>
    <section class="rounded-xl border border-border bg-card p-5">
      <h2 class="text-lg font-semibold">Add category limit</h2>
      <%= form_with model: @new_budget, url: finance_category_budgets_path, class: "mt-4 flex flex-wrap items-end gap-3" do |form| %>
        <label class="text-sm">Category <%= form.collection_select :category_id, @categories, :id, :name, { prompt: "Choose category" }, required: true, class: "mt-1 block rounded border-border bg-card" %></label>
        <label class="text-sm">Amount <%= form.number_field :amount, min: "0.01", step: "0.01", required: true, class: "mt-1 block w-32 rounded border-border bg-card" %></label>
        <label class="text-sm">Frequency <%= form.select :frequency, Financial::CategoryBudget::FREQUENCIES.map { |frequency| [frequency.humanize, frequency] }, {}, class: "mt-1 block rounded border-border bg-card" %></label>
        <label class="text-sm">Custom days <%= form.number_field :custom_days, min: 1, placeholder: "e.g. 10", class: "mt-1 block w-24 rounded border-border bg-card" %></label>
        <label class="text-sm">Starts on <%= form.date_field :starts_on, required: true, class: "mt-1 block rounded border-border bg-card" %></label>
        <%= render Ui::ButtonComponent.new(label: "Add budget", type: :submit) %>
      <% end %>
    </section>
  <% end %>
</section>
