<% form_url = @financial_entry.persisted? ? finance_transaction_path(@financial_entry) : finance_transactions_path %>
<%= form_with model: @financial_entry, scope: :financial_transaction, url: form_url, class: "grid gap-4 rounded-xl border border-border bg-card p-6 shadow-sm sm:grid-cols-2" do |form| %>
  <% if @financial_entry.errors.any? %>
    <p class="sm:col-span-2 text-sm text-destructive"><%= @financial_entry.errors.full_messages.to_sentence %></p>
  <% end %>

  <label class="space-y-1 text-sm">Type
    <%= render Ui::SelectComponent.new(name: "financial_transaction[transaction_type]", options: Financial::Transaction.transaction_types.map { |type| [type.humanize, type] }, selected: @financial_entry.transaction_type, required: true) %>
  </label>
  <label class="space-y-1 text-sm">Date
    <%= render Ui::InputComponent.new(name: "financial_transaction[transaction_date]", value: @financial_entry.transaction_date || Date.current, type: "date", required: true) %>
  </label>
  <label class="space-y-1 text-sm">Time (optional)
    <%= render Ui::InputComponent.new(name: "financial_transaction[entry_time]", value: @financial_entry.entry_time&.strftime("%H:%M"), type: "time") %>
  </label>
  <label class="space-y-1 text-sm">Amount
    <%= render Ui::InputComponent.new(name: "financial_transaction[amount]", value: @financial_entry.amount, type: "number", min: 0.01, step: 0.01, required: true) %>
  </label>
  <label class="space-y-1 text-sm">Description
    <%= render Ui::InputComponent.new(name: "financial_transaction[description]", value: @financial_entry.description, required: true) %>
  </label>
  <label class="space-y-1 text-sm">Source account
    <%= render Ui::SelectComponent.new(name: "financial_transaction[source_account_id]", options: @financial_accounts.map { |account| ["#{account.account_group.humanize}: #{account.name}", account.id] }, selected: @financial_entry.source_account_id, include_blank: "Outside this budget") %>
  </label>
  <label class="space-y-1 text-sm">Destination account
    <%= render Ui::SelectComponent.new(name: "financial_transaction[destination_account_id]", options: @financial_accounts.map { |account| ["#{account.account_group.humanize}: #{account.name}", account.id] }, selected: @financial_entry.destination_account_id, include_blank: "Outside this budget") %>
  </label>
  <label class="space-y-1 text-sm">Plan
    <%= render Ui::SelectComponent.new(name: "financial_transaction[plan_id]", options: @income_events.map { |plan| [plan.name, plan.id] }, selected: @financial_entry.plan_id, include_blank: "Not assigned") %>
  </label>
  <label class="space-y-1 text-sm">Category
    <%= render Ui::SelectComponent.new(name: "financial_transaction[category_id]", options: @categories.map { |category| [category.name, category.id] }, selected: @financial_entry.category_id, include_blank: "Not assigned") %>
  </label>
  <label class="space-y-1 text-sm">Budget period
    <%= render Ui::SelectComponent.new(name: "financial_transaction[budget_period_id]", options: @budget_periods.map { |period| [period.name, period.id] }, selected: @financial_entry.budget_period_id, include_blank: "Not assigned") %>
  </label>
  <label class="space-y-1 text-sm sm:col-span-2">Notes
    <%= form.text_area :notes, rows: 3, class: "w-full rounded-md border border-input bg-background px-3 py-2" %>
  </label>
  <div class="flex gap-2 sm:col-span-2">
    <%= render Ui::ButtonComponent.new(label: @financial_entry.persisted? ? "Save correction" : "Create transaction", type: "submit") %>
    <%= render Ui::ButtonComponent.new(href: @financial_entry.persisted? ? finance_transaction_path(@financial_entry) : finance_transactions_path, label: "Cancel", variant: :outline) %>
  </div>
<% end %>
