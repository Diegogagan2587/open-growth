<% content_for :title, "Transactions" %>
<section class="container mx-auto space-y-5 px-4 py-6">
  <header class="flex flex-wrap items-end justify-between gap-3">
    <div><h1 class="text-3xl font-bold">Transactions</h1><p class="mt-1 text-sm text-muted-foreground">Actual money movements. Bank verification is tracked separately from corrections.</p></div>
    <%= render Ui::ButtonComponent.new(href: new_finance_transaction_path, label: "New Transaction") %>
  </header>

  <%= form_with url: finance_transactions_path, method: :get, class: "grid gap-3 rounded-xl border border-border bg-card p-4 sm:grid-cols-2 lg:grid-cols-4" do |form| %>
    <%= form.date_field :date_from, value: params[:date_from], aria: { label: "Date from" }, class: "rounded-md border border-input bg-background px-3 py-2" %>
    <%= form.date_field :date_to, value: params[:date_to], aria: { label: "Date to" }, class: "rounded-md border border-input bg-background px-3 py-2" %>
    <%= form.select :account_id, @account_filter_options.map { |account| ["#{account.account_group.humanize}: #{account.name}", account.id] }, { include_blank: "All accounts", selected: params[:account_id] }, class: "rounded-md border border-input bg-background px-3 py-2" %>
    <%= form.select :transaction_type, Financial::Transaction.transaction_types.map { |type| [type.humanize, type] }, { include_blank: "All types", selected: params[:transaction_type] }, class: "rounded-md border border-input bg-background px-3 py-2" %>
    <%= form.select :category_id, @categories.map { |category| [category.name, category.id] }, { include_blank: "All categories", selected: params[:category_id] }, class: "rounded-md border border-input bg-background px-3 py-2" %>
    <%= form.select :reconciliation, [["Verified", "reconciled"], ["Not verified", "unreconciled"]], { include_blank: "Any verification", selected: params[:reconciliation] }, class: "rounded-md border border-input bg-background px-3 py-2" %>
    <%= form.text_field :q, value: params[:q], placeholder: "Search description", class: "rounded-md border border-input bg-background px-3 py-2" %>
    <%= render Ui::ButtonComponent.new(label: "Filter", type: "submit", variant: :outline) %>
  <% end %>

  <div class="overflow-hidden rounded-xl border border-border bg-card">
    <% @financial_entries.each do |transaction| %>
      <article class="grid gap-3 border-b border-border p-4 last:border-0 md:grid-cols-[7rem_1fr_1fr_auto] md:items-center">
        <div class="text-sm text-muted-foreground"><%= l(transaction.transaction_date) %><%= " · #{transaction.entry_time.strftime('%H:%M')}" if transaction.entry_time %></div>
        <div>
          <%= link_to transaction.description, finance_transaction_path(transaction), class: "font-semibold hover:text-accent hover:underline" %>
          <div class="mt-1 flex flex-wrap gap-2 text-xs text-muted-foreground"><span><%= transaction.transaction_type.humanize %></span><span><%= transaction.category&.name || "Uncategorized" %></span><span><%= transaction.reconciled_at? ? "Verified" : "Not verified" %></span></div>
        </div>
        <%= render Financial::TransactionRouteComponent.new(transaction: transaction) %>
        <strong class="text-right <%= financial_entry_amount_class(transaction) %>"><%= financial_entry_amount_prefix(transaction) %><%= number_to_currency(transaction.amount) %></strong>
      </article>
    <% end %>
    <% if @financial_entries.empty? %><p class="p-6 text-sm text-muted-foreground">No transactions match these filters.</p><% end %>
  </div>
</section>
