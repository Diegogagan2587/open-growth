<% content_for :title, @financial_entry.description %>
<section class="container mx-auto space-y-6 px-4 py-6">
  <%= link_to "← Back to transactions", finance_transactions_path, class: "text-sm text-accent hover:underline" %>
  <header class="flex flex-wrap items-start justify-between gap-4 rounded-2xl border border-border bg-card p-5 shadow-sm">
    <div><div class="flex flex-wrap gap-2"><%= render Ui::BadgeComponent.new(label: @financial_entry.transaction_type.humanize, variant: :outline) %><%= render Ui::BadgeComponent.new(label: @financial_entry.reconciled_at? ? "Verified" : "Not verified", variant: :outline) %></div><h1 class="mt-2 text-3xl font-bold"><%= @financial_entry.description %></h1><p class="mt-1 text-muted-foreground"><%= l(@financial_entry.transaction_date, format: :long) %><%= " · #{@financial_entry.entry_time.strftime('%H:%M')}" if @financial_entry.entry_time %></p></div>
    <strong class="text-2xl <%= financial_entry_amount_class(@financial_entry) %>"><%= financial_entry_amount_prefix(@financial_entry) %><%= number_to_currency(@financial_entry.amount) %></strong>
  </header>

  <section class="rounded-xl border border-border bg-card p-5"><h2 class="mb-3 text-lg font-semibold">Money movement</h2><%= render Financial::TransactionRouteComponent.new(transaction: @financial_entry, detailed: true) %></section>
  <dl class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <div class="rounded-xl border border-border bg-card p-4"><dt class="text-sm text-muted-foreground">Category</dt><dd class="mt-1 font-medium"><%= @financial_entry.category&.name || "Not assigned" %></dd></div>
    <div class="rounded-xl border border-border bg-card p-4"><dt class="text-sm text-muted-foreground">Budget period</dt><dd class="mt-1 font-medium"><%= @financial_entry.budget_period&.name || "Not assigned" %></dd></div>
    <div class="rounded-xl border border-border bg-card p-4"><dt class="text-sm text-muted-foreground">Plan</dt><dd class="mt-1 font-medium"><%= @financial_entry.plan ? link_to(@financial_entry.plan.name, finance_plan_path(@financial_entry.plan), class: "hover:underline") : "Not assigned" %></dd></div>
    <div class="rounded-xl border border-border bg-card p-4"><dt class="text-sm text-muted-foreground">Execution</dt><dd class="mt-1 font-medium"><%= @financial_entry.planned_transaction&.description || "Not workflow-created" %></dd></div>
    <div class="rounded-xl border border-border bg-card p-4"><dt class="text-sm text-muted-foreground">Reconciled at</dt><dd class="mt-1 font-medium"><%= @financial_entry.reconciled_at ? l(@financial_entry.reconciled_at, format: :long) : "Not verified" %></dd></div>
    <div class="rounded-xl border border-border bg-card p-4"><dt class="text-sm text-muted-foreground">Last updated</dt><dd class="mt-1 font-medium"><%= l(@financial_entry.updated_at, format: :long) %></dd></div>
  </dl>
  <% if @financial_entry.notes.present? %><section class="rounded-xl border border-border bg-card p-5"><h2 class="font-semibold">Notes</h2><p class="mt-2 whitespace-pre-wrap"><%= @financial_entry.notes %></p></section><% end %>

  <div class="flex flex-wrap gap-2">
    <%= render Ui::ButtonComponent.new(href: edit_finance_transaction_path(@financial_entry), label: "Correct", variant: :outline) %>
    <% if @financial_entry.reconciled_at? %>
      <%= render Ui::ButtonComponent.new(href: finance_transaction_reconciliation_path(@financial_entry), label: "Mark unverified", variant: :outline, method: :delete) %>
    <% else %>
      <%= render Ui::ButtonComponent.new(href: finance_transaction_reconciliation_path(@financial_entry), label: "Verify against bank", variant: :outline, method: :post) %>
    <% end %>
    <%= render Ui::ButtonComponent.new(href: finance_transaction_path(@financial_entry), label: "Delete", variant: :destructive, method: :delete, data: { turbo_confirm: @financial_entry.reconciled_at? ? "This transaction was verified against the bank. Delete it?" : "Delete this transaction?" }) %>
  </div>
</section>
