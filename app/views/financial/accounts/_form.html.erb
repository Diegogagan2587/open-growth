<% form_url = @financial_account.persisted? ? finance_account_path(@financial_account) : finance_accounts_path %>
<% account_types = Financial::Account::ACCOUNT_TYPES %>

<%= form_with model: @financial_account, scope: :financial_account, url: form_url, class: "grid gap-4 rounded-xl border border-border bg-card p-6 shadow-sm sm:grid-cols-2", data: { controller: "financial-account-form" } do |form| %>
  <label class="space-y-1 text-sm">
    Name
    <%= render Ui::InputComponent.new(name: "financial_account[name]", value: @financial_account.name, required: true) %>
  </label>

  <label class="space-y-1 text-sm">
    Group
    <%= render Ui::SelectComponent.new(name: "financial_account[account_group]", options: Financial::Account::ACCOUNT_GROUPS.map { |group| [group.humanize, group] }, selected: @financial_account.account_group, required: true, data: { "financial-account-form-target": "group", action: "change->financial-account-form#update" }) %>
  </label>

  <label class="space-y-1 text-sm">
    Type
    <%= render Ui::SelectComponent.new(
      name: "financial_account[account_type]",
      options: account_types.map { |type| [type.humanize, type] },
      selected: @financial_account.account_type,
      required: true,
      data: { "financial-account-form-target": "type" }
    ) %>
  </label>

  <label class="space-y-1 text-sm">
    Opening balance
    <%= render Ui::InputComponent.new(name: "financial_account[opening_balance]", value: @financial_account.opening_balance, type: "number", step: 0.01, required: true) %>
  </label>

  <label class="space-y-1 text-sm" data-financial-account-form-target="creditLimit"<%= " hidden" unless @financial_account.liability? %>>
      Credit limit (liabilities)
      <%= render Ui::InputComponent.new(name: "financial_account[credit_limit]", value: @financial_account.credit_limit, type: "number", min: 0.01, step: 0.01) %>
  </label>

  <label class="space-y-1 text-sm">
    Status
    <%= render Ui::SelectComponent.new(name: "financial_account[status]", options: Financial::Account::STATUSES.map { |status| [status.humanize, status] }, selected: @financial_account.status, required: true) %>
  </label>

  <label class="space-y-1 text-sm sm:col-span-2">
    Notes
    <%= form.text_area :notes, rows: 3, class: "w-full rounded-md border border-input bg-background px-3 py-2" %>
  </label>

  <div class="flex gap-2 sm:col-span-2">
    <%= render Ui::ButtonComponent.new(label: @financial_account.persisted? ? "Save account" : "Create account", type: "submit") %>
    <%= render Ui::ButtonComponent.new(href: @financial_account.persisted? ? finance_account_path(@financial_account) : finance_accounts_path, label: "Cancel", variant: :outline) %>
  </div>
<% end %>
