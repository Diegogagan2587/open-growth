<section class="space-y-6 p-6 sm:p-8">
  <div><%= link_to "← Back to loans", finance_loans_path, class: "text-sm text-primary hover:underline" %></div>
  <header class="flex flex-wrap items-start justify-between gap-4 border-b border-border pb-6">
    <div><div class="flex items-center gap-2"><h1 class="text-3xl font-bold"><%= @loan.name %></h1><%= render Ui::BadgeComponent.new(label: @loan.lifecycle_status.humanize, variant: :outline) %></div><p class="mt-2 text-muted-foreground"><%= @loan.lender_name.presence || "No lender specified" %></p></div>
    <div class="flex gap-2"><%= render Ui::ButtonComponent.new(href: edit_finance_loan_path(@loan), label: "Edit", variant: :outline) %><% if @loan.lifecycle_status == "simulated" && @loan.entries.empty? %><%= render Ui::ButtonComponent.new(href: finance_loan_path(@loan), label: "Delete simulation", variant: :destructive, method: :delete, data: { turbo_confirm: "Delete this simulation?" }) %><% end %></div>
  </header>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% [ [ "Principal", number_to_currency(@loan.principal_amount) ], [ "Actual debt", number_to_currency(@loan.actual_balance) ], [ "Interest", "#{@loan.interest_rate || 0}%" ], [ "Payments", @loan.number_of_payments || "—" ] ].each do |label, value| %>
      <div class="rounded-xl border border-border bg-card p-4"><p class="text-sm text-muted-foreground"><%= label %></p><p class="mt-2 text-xl font-bold"><%= value %></p></div>
    <% end %>
  </div>

  <% if @loan.lifecycle_status == "simulated" %>
    <section class="rounded-xl border border-border bg-card p-5">
      <h2 class="font-semibold">Activate and disburse</h2>
      <p class="mt-1 text-sm text-muted-foreground">Activation creates one actual disbursement entry. Configure one liability and one destination before activating.</p>
      <%= form_with url: activate_finance_loan_path(@loan), method: :post, class: "mt-4 flex flex-wrap items-end gap-2" do %>
        <label class="min-w-56 space-y-1 text-sm">Financial plan<%= render Ui::SelectComponent.new(name: "plan_id", options: @plans.map { |plan| [ plan.name, plan.id ] }, include_blank: "Select plan", required: true) %></label>
        <%= render Ui::ButtonComponent.new(label: "Activate loan", type: "submit") %>
      <% end %>
    </section>
  <% end %>

  <section class="space-y-3">
    <div class="flex flex-wrap items-end justify-between gap-3"><div><h2 class="text-xl font-semibold">Expected installments</h2><p class="text-sm text-muted-foreground">Installments are planning data until linked and applied.</p></div>
      <%= form_with url: generate_installments_finance_loan_path(@loan), method: :post, class: "flex items-end gap-2" do %><label class="space-y-1 text-sm">Start date<%= render Ui::InputComponent.new(name: "start_date", value: Date.current, type: "date", required: true) %></label><%= render Ui::ButtonComponent.new(label: "Generate schedule", type: "submit", variant: :outline, size: :sm) %><% end %>
    </div>
    <div class="overflow-x-auto rounded-xl border border-border bg-card">
      <table class="w-full text-left text-sm"><thead class="border-b border-border bg-muted/30"><tr><th class="p-3">#</th><th class="p-3">Due</th><th class="p-3">Expected</th><th class="p-3">Principal</th><th class="p-3">Interest</th><th class="p-3">Status</th><th class="p-3">Planning</th></tr></thead>
        <tbody class="divide-y divide-border"><% @installments.each do |installment| %><tr><td class="p-3"><%= installment.installment_number %></td><td class="p-3"><%= l(installment.due_date) %></td><td class="p-3"><%= number_to_currency(installment.expected_amount) %></td><td class="p-3"><%= number_to_currency(installment.expected_principal) %></td><td class="p-3"><%= number_to_currency(installment.expected_interest) %></td><td class="p-3"><%= installment.resolution.humanize %></td><td class="p-3">
          <% if installment.planned_transaction %><%= link_to installment.planned_transaction.plan&.name || "Unassigned", installment.planned_transaction.plan ? finance_plan_path(installment.planned_transaction.plan) : finance_planned_transactions_path, class: "text-primary hover:underline" %>
          <% elsif @loan.lifecycle_status == "active" %><%= form_with url: plan_installment_finance_loan_path(@loan, installment_id: installment.id), method: :post, class: "flex min-w-80 items-end gap-2" do %><%= render Ui::SelectComponent.new(name: "plan_id", options: @plans.map { |plan| [ plan.name, plan.id ] }, include_blank: "Plan", required: true) %><%= render Ui::SelectComponent.new(name: "financial_account_id", options: @assets.map { |asset| [ asset.name, asset.id ] }, include_blank: "Pay from", required: true) %><%= render Ui::ButtonComponent.new(label: "Plan", type: "submit", size: :sm) %><% end %><% end %>
        </td></tr><% end %></tbody>
      </table>
    </div>
  </section>

  <section><h2 class="text-xl font-semibold">Actual loan entries</h2><div class="mt-3 divide-y divide-border overflow-hidden rounded-xl border border-border bg-card"><% @entries.each do |entry| %><%= link_to finance_entry_path(entry), class: "flex justify-between p-4 hover:bg-muted/30" do %><span><%= entry.description %> · <%= entry.entry_type.humanize %></span><strong><%= number_to_currency(entry.amount) %></strong><% end %><% end %><% if @entries.empty? %><p class="p-4 text-sm text-muted-foreground">Simulation only—no actual debt entries.</p><% end %></div></section>
</section>
