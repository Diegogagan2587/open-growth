<section class="space-y-6 p-6 sm:p-8">
  <header class="flex flex-wrap items-center justify-between gap-4">
    <div><h1 class="text-3xl font-bold">Loans</h1><p class="mt-1 text-muted-foreground">Simulate obligations separately from actual debt entries.</p></div>
    <%= render Ui::ButtonComponent.new(href: new_finance_loan_path, label: "New simulation") %>
  </header>
  <div class="grid gap-4 lg:grid-cols-2">
    <% @loans.each do |loan| %>
      <article class="rounded-xl border border-border bg-card p-5 shadow-sm">
        <div class="flex items-start justify-between gap-3"><%= link_to loan.name, finance_loan_path(loan), class: "text-lg font-semibold hover:text-primary" %><%= render Ui::BadgeComponent.new(label: loan.lifecycle_status.humanize, variant: :outline) %></div>
        <p class="mt-3 text-2xl font-bold"><%= number_to_currency(loan.principal_amount) %></p>
        <p class="mt-1 text-sm text-muted-foreground"><%= loan.number_of_payments || "No" %> payments · <%= loan.liability&.name || "No real liability yet" %></p>
      </article>
    <% end %>
  </div>
</section>
