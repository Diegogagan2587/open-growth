<section aria-labelledby="actual-transactions-title" class="space-y-4">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 id="actual-transactions-title" class="text-xl font-semibold">
        Actual transactions
      </h2>

      <p class="text-sm text-muted-foreground">
        These movements determine balances and actual reports.
      </p>
    </div>

    <% unless plan.lifecycle_status.in?(%w[closed cancelled]) %>
      <%= render Ui::ButtonComponent.new(href: new_finance_transaction_path(plan_id: plan.id), label: "Add unplanned actual", variant: :outline, size: :sm) %>
    <% end %>
  </div>

  <div class="overflow-hidden rounded-xl border border-border bg-card">
    <% actual_entries.each do |transaction| %>
      <%= link_to finance_transaction_path(transaction), class: "flex flex-wrap items-center justify-between gap-3 border-b border-border p-4 last:border-0 hover:bg-muted/30" do %>
        <div>
          <p class="font-medium"><%= transaction.description %></p>

          <p class="text-xs text-muted-foreground">
            <%= transaction.transaction_type.humanize %> ·
            <%= l(transaction.transaction_date) %> ·
            <%= transaction.category&.name || "Uncategorized" %>
          </p>
        </div>

        <strong><%= number_to_currency(transaction.amount) %></strong>
      <% end %>
    <% end %>

    <% if actual_entries.empty? %>
      <p class="p-5 text-sm text-muted-foreground">
        No actual transactions are associated with this plan.
      </p>
    <% end %>
  </div>
</section>
