<section aria-labelledby="funding-sources-title" class="space-y-4">
  <div>
    <h2 id="funding-sources-title" class="text-xl font-semibold">
      Funding sources
    </h2>

    <p class="text-sm text-muted-foreground">
      Each source is one expected deposit. Several expected deposits are several
      sources.
    </p>
  </div>

  <div class="space-y-3">
    <% funding_sources.each do |source| %>
      <article class="rounded-xl border border-border bg-card p-4">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-semibold"><%= source.description %></h3>
              <%= render Ui::BadgeComponent.new(label: source.kind.humanize, variant: :outline) %>
              <%= render Ui::BadgeComponent.new(label: source.resolution.humanize, variant: source.receipt_transaction ? :secondary : :outline) %>
            </div>

            <p class="mt-2 text-sm text-muted-foreground">
              Expected <%= number_to_currency(source.expected_amount) %> on
              <%= l(source.expected_date) %>
              <% if source.receipt_transaction %>
                · Received <%= number_to_currency(source.actual_amount) %> on
                <%= l(source.actual_date) %>
              <% end %>
            </p>
          </div>

          <% if source.receipt_transaction %>
            <div class="flex gap-2">
              <%= link_to "View transaction", finance_transaction_path(source.receipt_transaction), class: "text-sm text-primary hover:underline" %><%= render Ui::ButtonComponent.new(href: finance_funding_source_receipt_path(source), label: "Remove receipt", variant: :outline, method: :delete, size: :sm, data: { turbo_confirm: "Remove this receipt and restore the expected source to pending?" }) %>
            </div>
          <% elsif source.kind != "borrowed" && !plan.lifecycle_status.in?(%w[closed cancelled]) %>
            <%= form_with url: finance_funding_source_receipt_path(source), method: :post, class: "flex flex-wrap items-end gap-2" do %>
              <label class="space-y-1 text-xs">Actual amount<%= render Ui::InputComponent.new(name: "funding_source[amount]", value: source.expected_amount, type: "number", min: 0.01, step: 0.01, required: true) %></label>
              <label class="space-y-1 text-xs">Actual date<%= render Ui::InputComponent.new(name: "funding_source[transaction_date]", value: source.expected_date, type: "date", required: true) %></label>

              <%= render Ui::ButtonComponent.new(label: "Receive", type: "submit", size: :sm) %>
            <% end %>
          <% end %>
        </div>

        <% if source.receipt_transaction.nil? && !plan.lifecycle_status.in?(%w[closed cancelled]) %>
          <details class="mt-3 text-sm">
            <summary class="cursor-pointer text-primary">
              Edit expectation
            </summary>

            <%= form_with url: finance_funding_source_path(source), method: :patch, class: "mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3" do %>
              <%= render Ui::InputComponent.new(name: "funding_source[description]", value: source.description, required: true) %>
              <%= render Ui::InputComponent.new(name: "funding_source[expected_amount]", value: source.expected_amount, type: "number", min: 0.01, step: 0.01, required: true) %>
              <%= render Ui::InputComponent.new(name: "funding_source[expected_date]", value: source.expected_date, type: "date", required: true) %>
              <%= render Ui::SelectComponent.new(name: "funding_source[kind]", options: Financial::FundingSource::KINDS.reject { |kind| kind == "borrowed" }.map { |kind| [kind.humanize, kind] }, selected: source.kind, required: true) %>
              <%= render Ui::SelectComponent.new(name: "funding_source[expected_destination_account_id]", options: (assets + liabilities).map { |account| ["#{account.account_group.humanize}: #{account.name}", account.id] }, selected: source.expected_destination_account_id, include_blank: "Select destination") %>

              <div class="flex gap-2">
                <%= render Ui::ButtonComponent.new(label: "Save", type: "submit", size: :sm) %>
                <%= render Ui::ButtonComponent.new(href: finance_funding_source_path(source), label: "Delete", variant: :destructive, method: :delete, size: :sm, data: { turbo_confirm: "Delete this expected funding source?" }) %>
              </div>
            <% end %>
          </details>
        <% end %>
      </article>
    <% end %>
  </div>

  <% unless plan.lifecycle_status.in?(%w[closed cancelled]) %>
    <details class="rounded-xl border border-border bg-card p-4">
      <summary class="cursor-pointer font-semibold">Add funding source</summary>

      <%= form_with url: finance_plan_funding_sources_path(plan), method: :post, class: "mt-4 grid gap-3 md:grid-cols-2 lg:grid-cols-3" do %>
        <label class="space-y-1 text-sm">Description<%= render Ui::InputComponent.new(name: "funding_source[description]", required: true) %></label>
        <label class="space-y-1 text-sm">Amount<%= render Ui::InputComponent.new(name: "funding_source[expected_amount]", type: "number", min: 0.01, step: 0.01, required: true) %></label>
        <label class="space-y-1 text-sm">Expected date<%= render Ui::InputComponent.new(name: "funding_source[expected_date]", value: plan.planned_for, type: "date", required: true) %></label>
        <label class="space-y-1 text-sm">Kind<%= render Ui::SelectComponent.new(name: "funding_source[kind]", options: Financial::FundingSource::KINDS.reject { |kind| kind == "borrowed" }.map { |kind| [kind.humanize, kind] }, selected: "income", required: true) %></label>
        <label class="space-y-1 text-sm">Destination<%= render Ui::SelectComponent.new(name: "funding_source[expected_destination_account_id]", options: (assets + liabilities).map { |account| ["#{account.account_group.humanize}: #{account.name}", account.id] }, include_blank: "Select destination", required: true) %></label>

        <div class="self-end">
          <%= render Ui::ButtonComponent.new(label: "Add source", type: "submit", size: :sm) %>
        </div>
      <% end %>
    </details>
  <% end %>
</section>
