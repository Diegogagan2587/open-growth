<section class="space-y-6 p-6 sm:p-8">
  <header
    class="
      flex flex-col gap-4 rounded-2xl border border-border bg-card p-5
      shadow-sm sm:flex-row sm:items-center sm:justify-between
    "
  >
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
        Financial plans
      </h1>

      <p class="mt-1 text-sm text-muted-foreground">
        <%= @budget_period ? "Plans grouped in #{@budget_period.name}." : "Plan expected funding and transactions without changing the actual ledger." %>
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= render Ui::ButtonComponent.new(href: finance_pending_expectations_path, label: t("finance.pending_transactions"), variant: :outline) %>
      <%= render Ui::ButtonComponent.new(href: new_finance_plan_path(budget_period_id: @budget_period&.id), label: "New plan") %>
    </div>
  </header>

  <%= form_with url: finance_plans_path, method: :get, class: "flex flex-col gap-3 rounded-xl border border-border bg-card p-4 shadow-sm sm:flex-row sm:items-end" do %>
    <%= hidden_field_tag :budget_period_id, @budget_period.id if @budget_period %>

    <label class="space-y-1 text-sm font-medium sm:w-52">
      Month
      <%= render Ui::InputComponent.new(name: "month", type: "month", value: @month) %>
    </label>

    <label class="space-y-1 text-sm font-medium sm:w-52">
      Status
      <%= render Ui::SelectComponent.new(name: "status", options: Financial::Plan::LIFECYCLE_STATUSES.map { |status| [ status.humanize, status ] }, selected: @status, include_blank: "All statuses") %>
    </label>

    <div class="flex gap-2">
      <%= render Ui::ButtonComponent.new(label: "Filter", type: "submit") %>

      <% if @month || @status %>
        <%= render Ui::ButtonComponent.new(href: finance_plans_path(budget_period_id: @budget_period&.id), label: "Clear", variant: :outline) %>
      <% end %>
    </div>
  <% end %>

  <% if @plans.any? %>
    <section aria-labelledby="plans-overview-title" class="space-y-3">
      <div>
        <h2 id="plans-overview-title" class="text-xl font-semibold">
          Plans overview
        </h2>

        <p class="text-sm text-muted-foreground">
          Forecast for the plans shown, separate from any individual plan's
          available money.
        </p>
      </div>

      <dl
        class="
          grid overflow-hidden rounded-xl border border-border bg-card
          sm:grid-cols-4
        "
      >
        <div class="border-b border-border p-4 sm:border-b-0 sm:border-r">
          <dt class="text-sm text-muted-foreground">Plans shown</dt>
          <dd class="mt-1 font-semibold"><%= @overview.plan_count %></dd>
        </div>

        <div class="border-b border-border p-4 sm:border-b-0 sm:border-r">
          <dt class="text-sm text-muted-foreground">Expected funding</dt>

          <dd class="mt-1 font-semibold">
            <%= number_to_currency(@overview.expected_funding) %>
          </dd>
        </div>

        <div class="border-b border-border p-4 sm:border-b-0 sm:border-r">
          <dt class="text-sm text-muted-foreground">Planned consumption</dt>

          <dd class="mt-1 font-semibold">
            <%= number_to_currency(@overview.planned_consumption) %>
          </dd>
        </div>

        <div class="p-4">
          <dt class="text-sm text-muted-foreground">Planned balance</dt>

          <dd class="mt-1 font-semibold">
            <%= number_to_currency(@overview.planned_balance) %>
          </dd>
        </div>
      </dl>
    </section>

    <div class="grid gap-4 lg:grid-cols-2">
      <% @plans.each do |plan| %>
        <% metrics = @overview.plan_metrics.fetch(plan.id) %>

        <article class="rounded-xl border border-border bg-card p-5 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <%= link_to plan.name, finance_plan_path(plan), class: "text-lg font-semibold text-foreground hover:text-primary" %>

              <p class="mt-1 text-sm text-muted-foreground">
                <%= l(plan.planned_for, format: :long) %>
              </p>
            </div>

            <%= render Ui::BadgeComponent.new(label: plan.lifecycle_status.humanize, variant: :outline) %>
          </div>

          <dl class="mt-5 grid grid-cols-2 gap-4 border-t border-border pt-4 text-sm">
            <div>
              <dt class="text-muted-foreground">Expected funding</dt>

              <dd class="mt-1 font-semibold">
                <%= number_to_currency(metrics.expected_funding) %>
              </dd>
            </div>

            <div>
              <dt class="text-muted-foreground">Planned consumption</dt>

              <dd class="mt-1 font-semibold">
                <%= number_to_currency(metrics.planned_consumption) %>
              </dd>
            </div>

            <div>
              <dt class="text-muted-foreground">Plan balance</dt>

              <dd class="mt-1 font-semibold <%= 'text-destructive' if metrics.planned_balance.negative? %>">
                <%= number_to_currency(metrics.planned_balance) %>
              </dd>
            </div>

            <div>
              <dt class="text-muted-foreground">Global balance through this plan</dt>

              <dd class="mt-1 font-semibold <%= 'text-destructive' if metrics.global_balance.negative? %>">
                <%= number_to_currency(metrics.global_balance) %>
              </dd>
            </div>
          </dl>

          <details class="mt-4 border-t border-border pt-3">
            <summary class="cursor-pointer text-sm font-medium text-primary">Correct global balance</summary>
            <p class="mt-2 text-xs text-muted-foreground">Set the actual balance at this point. Later plans will continue from this amount. Leave blank to remove the correction.</p>
            <%= form_with url: finance_plan_global_balance_correction_path(plan, budget_period_id: @budget_period&.id, month: @month, status: @status), method: :patch, class: "mt-3 flex flex-wrap items-end gap-2" do %>
              <label class="space-y-1 text-sm">Actual global balance
                <%= render Ui::InputComponent.new(name: "financial_plan[global_balance_override]", value: metrics.global_balance, type: "number", step: "0.01") %>
              </label>
              <%= render Ui::ButtonComponent.new(label: "Save correction", type: "submit", size: :sm) %>
            <% end %>
          </details>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border-2 border-dashed border-border p-10 text-center">
      <p class="font-medium">
        <%= @month || @status ? "No plans match these filters." : "No financial plans yet." %>
      </p>

      <p class="mt-1 text-sm text-muted-foreground">
        <%= @month || @status ? "Try another month or status." : "Create a plan with its first expected funding source." %>
      </p>
    </div>
  <% end %>
</section>
