<section class="container mx-auto space-y-6 px-4 py-6">
  <div>
    <h1 class="text-3xl font-bold">Unassigned planned transactions</h1>

    <p class="mt-1 text-muted-foreground">
      Obligations can exist before you decide which plan will fund them.
    </p>
  </div>

  <% @planned_transactions.each do |transaction| %>
    <article class="rounded-xl border border-border bg-card p-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="font-semibold"><%= transaction.description %></h2>

          <p class="text-sm text-muted-foreground">
            <%= transaction.kind.humanize %> ·
            <%= number_to_currency(transaction.planned_amount) %> ·
            <%= transaction.execution_status.humanize %>
          </p>
        </div>

        <% if transaction.execution_status == "pending" %>
          <%= form_with url: finance_planned_transaction_path(transaction), method: :patch, class: "flex items-end gap-2" do %>
            <%= render Ui::SelectComponent.new(name: "planned_transaction[plan_id]", options: @plans.map { |plan| [ plan.name, plan.id ] }, include_blank: "Select plan", required: true) %>
            <%= render Ui::ButtonComponent.new(label: "Assign", type: "submit", variant: :outline, size: :sm) %>
          <% end %>
        <% end %>
      </div>
    </article>
  <% end %>

  <% if @planned_transactions.empty? %>
    <p class="rounded-xl border border-border bg-muted/20 p-6 text-muted-foreground">
      No unassigned planned transactions.
    </p>
  <% end %>
</section>
