<% content_for :head do %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<% end %>

<div class="container mx-auto px-4 py-4">
  <h1 class="text-2xl font-bold mb-4"><%= t("reports.category_trends_title") %></h1>
  <%= render "reports/report_nav", current: :category_trends, date_from: @date_from, date_to: @date_to, period: @period %>

  <%= render Reports::FilterComponent.new(
        url: reports_category_trends_path,
        date_from: @date_from,
        date_to: @date_to,
        period: @period,
        period_options: report_trend_period_options,
        params_hash: params.permit(:from, :to, :period).to_h
      ) %>

  <% if @categories_summary.blank? %>
    <p class="text-muted-foreground py-8"><%= t("reports.empty_trends") %></p>
  <% else %>
    <%= render Ui::LineChartCardComponent.new(
          chart_config: @chart_config,
          title: t("reports.category_trends_chart_title"),
          description: t("reports.category_trends_description")
        ) %>

    <section class="rounded-xl border border-border bg-card text-card-foreground shadow-sm">
      <div class="hidden md:block overflow-x-auto">
        <table class="ui-table overflow-visible">
          <thead class="bg-muted/50">
            <tr>
              <th scope="col" class="sticky left-0 z-30 w-48 min-w-48 max-w-48 border-r border-border bg-muted px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-muted-foreground"><%= t("reports.category") %></th>
              <% @period_labels.each do |label| %>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-muted-foreground uppercase tracking-wide whitespace-nowrap"><%= label %></th>
              <% end %>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-muted-foreground uppercase tracking-wide"><%= t("reports.total") %></th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-muted-foreground uppercase tracking-wide"><%= t("reports.view_expenses") %></th>
            </tr>
          </thead>
          <tbody class="bg-card divide-y divide-border">
            <% @categories_summary.each do |cat| %>
              <tr>
                <td class="sticky left-0 z-10 w-48 min-w-48 max-w-48 border-r border-border bg-card px-4 py-3 text-sm font-medium text-card-foreground"><span class="block truncate" title="<%= cat[:category_name] %>"><%= cat[:category_name] %></span></td>
                <% cat[:amounts].each_with_index do |amt, index| %>
                  <% bucket = @buckets[index] %>
                  <td class="px-4 py-3 text-sm text-right tabular-nums whitespace-nowrap text-card-foreground">
                    <%= link_to number_to_currency(amt), finance_entries_path(category_id: cat[:category_id], date_from: bucket[:date_from], date_to: bucket[:date_to], entry_type: "expenses"), title: "#{cat[:category_name]} · #{bucket[:label]}", class: "rounded-sm hover:text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" %>
                  </td>
                <% end %>
                <td class="px-4 py-3 text-sm text-right font-medium tabular-nums text-card-foreground">
                  <%= link_to number_to_currency(cat[:total]), finance_entries_path(category_id: cat[:category_id], date_from: @date_from, date_to: @date_to, entry_type: "expenses"), title: "#{cat[:category_name]} · #{t('reports.total')}", class: "rounded-sm hover:text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" %>
                </td>
                <td class="px-4 py-3 text-sm text-right">
                  <%= link_to t("reports.view_expenses"), finance_entries_path(category_id: cat[:category_id], date_from: @date_from, date_to: @date_to, entry_type: "expenses"), class: "text-primary hover:underline font-medium" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="md:hidden divide-y divide-border">
        <% @categories_summary.each do |cat| %>
          <div class="p-3 sm:p-4">
            <div class="flex justify-between items-start gap-2 mb-3">
              <span class="text-sm font-semibold text-card-foreground break-words min-w-0 flex-1 leading-snug"><%= cat[:category_name] %></span>
              <%= link_to number_to_currency(cat[:total]), finance_entries_path(category_id: cat[:category_id], date_from: @date_from, date_to: @date_to, entry_type: "expenses"), title: "#{cat[:category_name]} · #{t('reports.total')}", class: "shrink-0 rounded-sm text-sm font-semibold tabular-nums text-card-foreground hover:text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" %>
            </div>
            <div class="grid grid-cols-2 gap-x-3 gap-y-1.5 text-xs text-muted-foreground mb-3">
              <% @period_labels.each_with_index do |label, idx| %>
                <% bucket = @buckets[idx] %>
                <span class="truncate min-w-0" title="<%= label %>"><%= label %></span>
                <%= link_to number_to_currency(cat[:amounts][idx] || 0), finance_entries_path(category_id: cat[:category_id], date_from: bucket[:date_from], date_to: bucket[:date_to], entry_type: "expenses"), title: "#{cat[:category_name]} · #{label}", class: "text-right tabular-nums font-medium text-card-foreground hover:text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" %>
              <% end %>
            </div>
            <%= link_to t("reports.view_expenses"), finance_entries_path(category_id: cat[:category_id], date_from: @date_from, date_to: @date_to, entry_type: "expenses"), class: "inline-flex items-center justify-center w-full rounded-md border border-border bg-background px-3 py-2 text-sm font-medium text-primary hover:bg-muted/50 transition-colors" %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
