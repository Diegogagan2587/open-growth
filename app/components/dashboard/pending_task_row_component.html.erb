<li data-task-kind="<%= recurring? ? 'recurring' : 'project' %>" class="flex items-center gap-1.5 py-2.5 first:pt-3 last:pb-3 sm:gap-2">
  <%= link_to detail_path,
    data: detail_data,
    class: "flex min-w-0 flex-1 flex-col items-start gap-1 rounded-sm px-1 py-1.5 outline-none hover:text-accent-dark focus-visible:ring-2 focus-visible:ring-ring sm:flex-row sm:items-center sm:justify-between sm:gap-3" do %>
    <span class="w-full min-w-0 sm:w-auto">
      <span class="block break-words sm:truncate <%= 'font-semibold text-danger' if task.overdue? %>"><%= title %></span>
      <span class="mt-0.5 block break-words text-xs text-muted-foreground sm:truncate"><%= context_label %></span>
    </span>
    <% if due_date.present? %>
      <span class="text-xs <%= task.overdue? ? 'font-semibold text-danger' : 'text-muted-foreground' %> sm:shrink-0"><%= helpers.l(due_date, format: :short) %></span>
    <% end %>
  <% end %>

  <%= form_with url: completion_path, method: :patch, class: "shrink-0" do %>
    <%= hidden_field_tag "task[status]", "done" unless recurring? %>
    <%= render Ui::ButtonComponent.new(
      label: t("task.recurring_tasks.mark_done"),
      variant: :default,
      size: :sm,
      type: "submit",
      aria_label: "#{t('task.recurring_tasks.mark_done')}: #{title}",
      css_class: "h-10 w-10 p-0 sm:h-8 sm:w-auto sm:px-3"
    ) do %>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
        <path d="m5 12 4 4L19 6" />
      </svg>
      <span class="sr-only sm:not-sr-only"><%= t("task.recurring_tasks.mark_done") %></span>
    <% end %>
  <% end %>

  <%= form_with url: deferral_path, method: :post, class: "shrink-0" do %>
    <%= hidden_field_tag :task_id, task.id %>
    <%= hidden_field_tag :task_type, task_type %>
    <%= render Ui::ButtonComponent.new(
      label: t("dashboard.defer_task"),
      aria_label: t("dashboard.defer_task_aria", task: title),
      variant: :ghost,
      size: :sm,
      type: "submit",
      css_class: "h-10 w-10 p-0 sm:h-8 sm:w-auto sm:px-2"
    ) do %>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
        <circle cx="10" cy="12" r="8" />
        <path d="M10 8v4l2 1.5" />
        <path d="M16 18h6m-3-3 3 3-3 3" />
      </svg>
      <span class="sr-only sm:not-sr-only"><%= t("dashboard.defer_task") %></span>
    <% end %>
  <% end %>
</li>
