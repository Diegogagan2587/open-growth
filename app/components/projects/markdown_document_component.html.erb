<section class="mobile-reader md:hidden" data-controller="document-reader">
  <header class="reader-chrome" data-document-reader-target="chrome">
    <button type="button" class="reader-icon-button" aria-label="Back" onclick="history.back()">←</button>
    <p class="reader-title"><%= @title %></p>
    <button type="button" class="reader-icon-button" aria-label="Reading options" data-action="document-reader#toggleChrome">Aa</button>
  </header>

  <div class="reader-pages" data-document-reader-target="pages" data-action="touchstart->document-reader#startTouch touchmove->document-reader#moveTouch touchend->document-reader#endTouch touchcancel->document-reader#cancelTouch click->document-reader#tap">
    <article class="reader-page markdown-content">
      <h1 class="reader-cover-title"><%= @title %></h1>
      <% if @markdown.present? %>
        <%= helpers.render_markdown(@markdown) %>
      <% else %>
        <p>No content yet.</p>
      <% end %>
    </article>
    <div class="reader-book" data-document-reader-target="book"></div>
  </div>

  <footer class="reader-chrome reader-footer" data-document-reader-target="chrome">
    <button type="button" class="reader-icon-button" aria-label="Previous page" data-action="document-reader#previous">‹</button>
    <p class="reader-progress" data-document-reader-target="progress">1 / 1</p>
    <button type="button" class="reader-icon-button" aria-label="Next page" data-action="document-reader#next">›</button>
  </footer>
</section>

<div class="hidden md:block" data-controller="markdown-outline">
  <div class="grid min-w-0 gap-6 lg:grid-cols-[minmax(0,1fr)_15rem]">
    <details class="rounded-xl border border-border bg-card p-3 lg:hidden">
      <summary class="cursor-pointer text-sm font-semibold text-foreground">Outline</summary>
      <nav class="mt-3 space-y-1" aria-label="Document outline" data-markdown-outline-target="outline"></nav>
    </details>

    <article class="min-w-0 rounded-2xl border border-border bg-card p-5 shadow-sm sm:p-8 lg:p-10">
      <% if @markdown.present? %>
        <div class="markdown-content desktop-document-content mx-auto max-w-[72ch] text-foreground" data-markdown-outline-target="content">
          <%= helpers.render_markdown(@markdown) %>
        </div>
      <% else %>
        <p class="text-sm text-muted-foreground" data-markdown-outline-target="content">No content yet.</p>
      <% end %>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-4 rounded-xl border border-border bg-card p-4 shadow-sm">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted-foreground">Outline</h2>
        <nav class="space-y-1" aria-label="Document outline" data-markdown-outline-target="outline"></nav>
      </div>
    </aside>
  </div>
</div>
